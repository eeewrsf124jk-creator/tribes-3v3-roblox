-- Items every new profile owns at level 1 (no UnlockShards and not ranked-only).
local function isStarter(spec: EquipmentSpec): boolean
	return spec.UnlockShards == nil and spec.RankedOnly ~= true
end

-- Glory (RP) needed to unlock each ranked melee.
local RankedUnlockGlory: { [string]: number } = {
	Gauntlets = 300,
	TwinHatchets = 600,
	Katana = 1000,
	Scythe = 1600,
}

-- One bundle = this many rounds.
local AmmoBundles = {
	Arrows = 12,
	Bullets = 6,
	FireArrows = 6,
}

-- Points each bundle costs (fire arrows are the premium ammo).
local AmmoBundleCost = {
	Arrows = 1,
	Bullets = 1,
	FireArrows = 2,
}

-- Most bundles of each kind one loadout may carry (36 arrows / 12 bullets / 12 fire arrows).
local AmmoBundleMax = {
	Arrows = 3,
	Bullets = 2,
	FireArrows = 2,
}

local EquipmentDatabase = {
	Items = Items,
	Order = Order,
	AmmoBundles = AmmoBundles,
	AmmoBundleCost = AmmoBundleCost,
	AmmoBundleMax = AmmoBundleMax,
	RankedUnlockGlory = RankedUnlockGlory,
	MaxPoints = 12,
	MaxSlots = 6,
	BackstabDamage = 250,
}

function EquipmentDatabase.Get(id: string): EquipmentSpec?
	return Items[id]
end

function EquipmentDatabase.IsStarter(id: string): boolean
	local spec = Items[id]
	return spec ~= nil and isStarter(spec)
end

function EquipmentDatabase.IsRanged(spec: EquipmentSpec): boolean
	return spec.SubType == "BOW" or spec.SubType == "GUN" or spec.SubType == "THROWABLE"
end

function EquipmentDatabase.UsesProjectile(spec: EquipmentSpec): boolean
	return spec.ProjectileSpeed ~= nil
end

-- Stack size a single purchase grants. Weapons without MaxStack are reusable (returns 0 = infinite).
function EquipmentDatabase.StackSize(spec: EquipmentSpec): number
	if spec.MaxStack ~= nil then
		return spec.MaxStack
	end
	if spec.Category == "HEALING" or spec.Category == "UTILITY" then
		if spec.Cooldown ~= nil then
			return 0
		end
		return 1
	end
	return 0
end

function EquipmentDatabase.StarterItems(): { string }
	local list = {}
	for _, id in Order do
		if isStarter(Items[id]) then
			table.insert(list, id)
		end
	end
	return list
end

return EquipmentDatabase
